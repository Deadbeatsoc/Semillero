# Puerto de la API local
PORT=4000

# Ciudad por defecto para el evento init de Socket.IO
DEFAULT_CITY=villavicencio

# Ruta opcional a un GeoJSON local con predicciones precomputadas.
# Si no existe, el backend usa un modelo local sintetico entrenado en memoria.
# Ejemplo: LOCAL_PREDICTIONS_GEOJSON=C:\ruta\predicciones.geojson
# LOCAL_PREDICTIONS_GEOJSON=

# Configuracion opcional de geocodificacion (autocompletar y seleccion por mapa).
# En produccion configura un User-Agent identificable.
GEOCODER_USER_AGENT=websemillero-local/1.0
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Clima
# Proveedor por defecto: Open-Meteo (GRATIS, sin API key). Funciona sin configurar nada.
# WEATHER_PROVIDER=open-meteo        # o "weatherapi" si prefieres WeatherAPI.com
# WEATHER_FORECAST_DAYS=3            # dias de pronostico (1-10)
# WEATHER_TIMEZONE=America/Bogota
#
# Opcional: WeatherAPI.com (requiere key). Si la configuras y open-meteo falla,
# se usa como respaldo automatico.
# Crea tu key en: https://www.weatherapi.com/
WEATHERAPI_KEY=
# Alternativa equivalente (puedes usar esta en vez de WEATHERAPI_KEY):
# WEATHER_API_KEY=
# Compatibilidad: WEATHER_API_DAYS sigue funcionando como alias de WEATHER_FORECAST_DAYS.
WEATHER_API_DAYS=3
# Endpoints base opcionales:
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# Configuracion de MySQL (migraciones y almacenamiento persistente)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=movilidad
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Auth / control de acceso
# Se usan para bootstrap automatico del primer admin si no existe ninguno.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin12345
# Codigo inicial opcional para registro de usuarios normales.
# Si no se define, se genera uno aleatorio.
# ADMIN_INITIAL_VERIFICATION_CODE=123456
# Duracion de sesion en horas.
AUTH_SESSION_HOURS=12

# Seed Villavicencio (opcional)
# SEED_ACCIDENT_COUNT=5000
# SEED_DELETE_PREVIOUS=true
# OVERPASS_URL=https://overpass-api.de/api/interpreter
